<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:paddingHorizontal="@dimen/fragment_padding_medium">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginVertical="@dimen/_12sdp"
        android:background="@drawable/background_card"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_25sdp"
        android:paddingVertical="@dimen/_18sdp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_online_username_hint" />

        <com.kdt.mcgui.MineEditText
            android:id="@+id/login_edit_email"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_37sdp"
            android:imeOptions="flagNoExtractUi"
            android:inputType="textNoSuggestions"
            android:maxLength="16"
            android:textSize="@dimen/_16ssp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="@string/pengu_sifre" />

        <com.kdt.mcgui.MineEditText
            android:id="@+id/pengu_login_sifre"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_37sdp"
            android:imeOptions="flagNoExtractUi"
            android:inputType="textPassword"
            android:textSize="@dimen/_16ssp" />

        <com.kdt.mcgui.MineEditText
            android:id="@+id/pengu_login_sifre_tekrar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_37sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:hint="@string/pengu_sifre_tekrar"
            android:imeOptions="flagNoExtractUi"
            android:inputType="textPassword"
            android:textSize="@dimen/_16ssp"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/pengu_login_kayit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:text="@string/pengu_kayit_modu" />

        <TextView
            android:id="@+id/pengu_login_hata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF5D5D"
            android:visibility="gone" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/login_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_42sdp"
            android:layout_marginTop="@dimen/padding_heavy"
            android:text="@string/login_online_login_label"
            android:textColor="@android:color/white" />
    </LinearLayout>
</ScrollView>
